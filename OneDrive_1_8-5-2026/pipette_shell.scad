  1. Download and install OpenSCAD (free) from openscad.org
  2. Open this file in OpenSCAD
  3. Press F5 to preview, F6 to render, and F7 to export to STL!
*/

// --- Dimensions & Parameters ---
$fn = 100; // High resolution for smooth curves

// Main Body
cylinder_length = 160;
inner_diameter = 32.5; // Slightly larger than 31mm prototype width
wall_thickness = 2.0;
outer_diameter = inner_diameter + (wall_thickness * 2);

// Nose Cone (Pipette Tip Mount)
nose_length = 40;
nose_tip_diameter = 5.0;

// Electronics Cutouts
oled_width = 27.5;
oled_height = 27.5; // Typical 0.96" OLED PCB
oled_y_offset = cylinder_length - 55;

actuator_window_length = 60;
actuator_window_width = 12;
actuator_window_y = 35;

// Buttons
button_diameter = 7;
btn_plus_y = oled_y_offset - 15;
btn_minus_y = oled_y_offset - 30;
btn_menu_y = oled_y_offset - 45;

// Ergonomic Hook
hook_radius = 12;
hook_width = 15;
hook_y = cylinder_length - 20;

// --- Modules ---

module outer_shell() {
    union() {
        // Main cylindrical body
        cylinder(h=cylinder_length, d=outer_diameter);
        
        // Tapered nose cone
        translate([0, 0, -nose_length])
            cylinder(h=nose_length, d1=nose_tip_diameter, d2=outer_diameter);
            
        // Ergonomic Finger Hook (Back side, -X)
        translate([-outer_diameter/2, 0, hook_y])
        rotate([0, 90, 0])
        hull() {
            cylinder(h=hook_width, r=hook_radius, center=true);
            translate([-10, 0, 0])
                cube([hook_radius*2, hook_radius*2, hook_width], center=true);
        }
    }
}

module inner_cavity() {
    union() {
        // Main hollow cavity
        translate([0, 0, -0.1])
            cylinder(h=cylinder_length + 0.2, d=inner_diameter);
            
        // Nose cone hollow
        translate([0, 0, -nose_length - 0.1])
            cylinder(h=nose_length + 0.2, d1=nose_tip_diameter-2, d2=inner_diameter);
    }
}

module cutouts() {
    // OLED Window (Front side, +Y)
    translate([0, outer_diameter/2, oled_y_offset])
    cube([oled_width, outer_diameter, oled_height], center=true);
    
    // Actuator Viewing Window
    translate([0, outer_diameter/2, actuator_window_y])
    hull() {
        translate([0, 0, actuator_window_length/2])
            rotate([90, 0, 0]) cylinder(h=outer_diameter, d=actuator_window_width, center=true);
        translate([0, 0, -actuator_window_length/2])
            rotate([90, 0, 0]) cylinder(h=outer_diameter, d=actuator_window_width, center=true);
    }
    
    // + Button
    translate([10, outer_diameter/2, btn_plus_y])
        rotate([90, 0, 0]) cylinder(h=outer_diameter, d=button_diameter, center=true);
        
    // - Button
    translate([-10, outer_diameter/2, btn_plus_y])
        rotate([90, 0, 0]) cylinder(h=outer_diameter, d=button_diameter, center=true);
        
    // MENU Button (pill shaped)
    translate([0, outer_diameter/2, btn_menu_y])
    hull() {
        translate([5, 0, 0]) rotate([90, 0, 0]) cylinder(h=outer_diameter, d=button_diameter, center=true);
        translate([-5, 0, 0]) rotate([90, 0, 0]) cylinder(h=outer_diameter, d=button_diameter, center=true);
    }
}

// --- Assembly ---

// To split the model into left and right halves for 3D printing, 
// we intersect the result with a bounding box.

module left_half() {
    difference() {
        difference() {
            outer_shell();
            inner_cavity();
            cutouts();
        }
        // Cut away the right side
        translate([0, -outer_diameter, -nose_length-10])
            cube([outer_diameter*2, outer_diameter*2, cylinder_length*2]);
    }
}

module right_half() {
    difference() {
        difference() {
            outer_shell();
            inner_cavity();
            cutouts();
        }
        // Cut away the left side
        translate([-outer_diameter*2, -outer_diameter, -nose_length-10])
            cube([outer_diameter*2, outer_diameter*2, cylinder_length*2]);
    }
}

// Display both halves slightly separated
translate([-2, 0, 0]) left_half();
translate([2, 0, 0]) right_half();
